SERVER_PORT=9090

# Production (Render): PORT tu dong inject, khong can set SERVER_PORT
# APP_UPLOAD_PUBLIC_URL_PREFIX=https://petcare-api.onrender.com/uploads
# APP_UPLOAD_ROOT_DIR=/var/data/uploads
# APP_UPLOAD_BLOG_COVER_DIR=blog-cover
# SPRING_MULTIPART_MAX_FILE_SIZE=40MB
# SPRING_MULTIPART_MAX_REQUEST_SIZE=200MB
# APP_UPLOAD_MAX_FILE_SIZE_MB=40

DB_URL=jdbc:mysql://localhost:3306/pet_care?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

JWT_SECRET=change-this-to-a-long-random-secret-key-at-least-32-characters
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=2592000000
PASSWORD_RESET_OTP_EXPIRATION_MINUTES=10
VACCINE_SEED_ENABLED=true
REMINDER_BATCH_SIZE=100
REMINDER_SCHEDULER_ENABLED=true
REMINDER_CUSTOM_WORKER_DELAY_MS=60000
REMINDER_VACCINE_WORKER_DELAY_MS=60000
REMINDER_VACCINE_NOTIFICATION_TIME=09:00

FIREBASE_ENABLED=false
# Local: đặt file service account ở máy bạn rồi trỏ path tuyệt đối.
FIREBASE_SERVICE_ACCOUNT_PATH=D:/pet_care/secrets/firebase-service-account.json
# Deploy: dùng base64 của toàn bộ JSON service account thay cho path.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GEMINI_API_KEY=your-google-gemini-api-key
NDA_MAP_API_KEY=your-nda-map-api-key
NDA_MAP_BASE_URL=https://mapapis.ndamaps.vn/v1
NDA_MAP_CLINIC_CATEGORY=veterinary_care
NDA_MAP_MAX_RADIUS_KM=5
NDA_MAP_MAX_RESULTS=10
NDA_MAP_DETAIL_ENRICHMENT_LIMIT=5

# File storage: cloudinary or local
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Mail provider: resend, smtp, or log
MAIL_PROVIDER=resend
MAIL_SENDER_EMAIL=your_sender_email@example.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=PetCare <onboarding@resend.dev>

# Optional SMTP fallback
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEV_EXPOSE_OTP=false
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_READ_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000
