SERVER_PORT=9090

# Production (Render): PORT tu dong inject, khong can set SERVER_PORT
# APP_UPLOAD_PUBLIC_URL_PREFIX=https://petcare-api.onrender.com/uploads
# APP_UPLOAD_ROOT_DIR=/var/data/uploads

DB_URL=jdbc:mysql://localhost:3306/pet_care?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

JWT_SECRET=change-this-to-a-long-random-secret-key-at-least-32-characters
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=2592000000
PASSWORD_RESET_OTP_EXPIRATION_MINUTES=10
VACCINE_SEED_ENABLED=true
REMINDER_BATCH_SIZE=100
REMINDER_SCHEDULER_ENABLED=true
REMINDER_CUSTOM_WORKER_DELAY_MS=60000
REMINDER_VACCINE_WORKER_DELAY_MS=60000
REMINDER_VACCINE_NOTIFICATION_TIME=09:00

FIREBASE_ENABLED=false
# Local: đặt file service account ở máy bạn rồi trỏ path tuyệt đối.
FIREBASE_SERVICE_ACCOUNT_PATH=D:/pet_care/secrets/firebase-service-account.json
# Deploy: dùng base64 của toàn bộ JSON service account thay cho path.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

MAIL_PROVIDER=smtp
MAIL_SENDER_EMAIL=your_email@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEV_EXPOSE_OTP=false
